{
  "name": "ephemera",
  "version": "0.1.0",
  "private": true,
  "description": "Ephemera: a paper UI design system for React. shadcn/ui-compatible components styled as stationery.",
  "license": "MIT",
  "author": {
    "name": "KerrShift",
    "url": "https://kerrshift.com"
  },
  "contributors": [
    {
      "name": "Sahil Gangurde",
      "url": "https://lostmartian.in"
    }
  ],
  "homepage": "https://ephemera.kerrshift.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kerrshift/ephemera.git"
  },
  "bugs": {
    "url": "https://github.com/kerrshift/ephemera/issues"
  },
  "keywords": [
    "paper-ui",
    "paper-ux",
    "paper-design-system",
    "skeuomorphic",
    "design-system",
    "react",
    "shadcn",
    "shadcn-ui",
    "shadcn-registry",
    "tailwindcss",
    "radix-ui",
    "components",
    "ui"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/build-registry.mjs && next dev",
    "build": "node scripts/build-registry.mjs && next build",
    "registry": "node scripts/build-registry.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "next": "16.4.0",
    "radix-ui": "^1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  }
}
