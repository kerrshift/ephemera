# Cloudflare static asset headers (https://developers.cloudflare.com/workers/static-assets/headers/)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# hashed build assets never change
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# generated images are written without a file extension
/opengraph-image
  Content-Type: image/png
/components/*/opengraph-image
  Content-Type: image/png
/apple-icon
  Content-Type: image/png

# shadcn registry: fetched by the CLI and by AI tools
/r/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, must-revalidate

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
